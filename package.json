{
  "name": "profound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:migrate": "bash migrate/run.sh up",
    "db:migrate:status": "bash migrate/run.sh status",
    "db:migrate:down": "bash migrate/run.sh down",
    "db:migrate:remote": "vercel env pull .env.production.local --environment production && set -a && . ./.env.production.local && set +a && node migrate/run-remote.mjs",
    "db:clean": "docker exec profound-postgres-1 psql -U profound -d profound -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && bash migrate/run.sh up",
    "dev": "docker compose up -d --wait && bash migrate/run.sh up && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run db:migrate:remote && vercel deploy --prod"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.6",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.12.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pg-boss": "^12.18.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "robots-parser": "^3.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
